{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "master"
  },
  "guard": {
    "directCommands": {
      "npmScripts": [],
      "npxTools": [],
      "cargoSubcommands": [
        "check",
        "test",
        "clippy",
        "fmt"
      ],
      "tools": [
        "git"
      ]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "rust",
      "config": {
        "includePatterns": [
          "**/*.rs",
          "Cargo.toml",
          "Cargo.lock"
        ],
        "excludePatterns": [
          "**/target/**",
          "**/.git/**"
        ]
      }
    }
  }
}
